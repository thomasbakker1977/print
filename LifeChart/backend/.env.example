# Copy to .env and fill in. Never commit .env.

# Shared secret the iPhone app sends as a bearer token (at least 32 characters).
# Generate one with:  openssl rand -hex 32
LIFECHART_API_TOKEN=

# Anthropic API key for the coach (https://console.anthropic.com).
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5

# Who the coach points you to in a crisis when your own crisis plan (set in
# the app) has no contacts. Personal contacts belong in the app, not here.
COACH_CRISIS_INFO=113 Zelfmoordpreventie (bel 113 of 0800-0113, of chat via 113.nl), de huisartsenpost, of 112 bij direct gevaar

# Garmin Connect: preferably run the one-time login instead of storing your
# password here (it also handles two-factor codes):
#   docker compose run --rm lifechart python -m app.garmin_login
# The saved tokens are enough afterwards. If you do set these, remove
# GARMIN_PASSWORD again once the first sync has worked.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_SYNC_MINUTES=240

# Day boundaries for Garmin and the coach use this time zone.
TZ=Europe/Amsterdam

# --- Cloudflare -------------------------------------------------------------
# Tunnel token from Zero Trust → Networks → Tunnels → (your tunnel) → Docker.
# Route the public hostname (e.g. lifechart.example.nl) to http://lifechart:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access application protecting that hostname. With both set, the
# backend rejects every API call that did not pass Cloudflare Access.
# Team domain: <team>.cloudflareaccess.com; AUD: the application's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: send coach traffic through Cloudflare AI Gateway (spend limits,
# analytics). Turn OFF request/response logging in the gateway settings, since
# prompts contain your health data.
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/anthropic
